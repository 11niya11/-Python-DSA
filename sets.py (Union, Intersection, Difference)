# sets.py
# Basic set operations in Python

A = {1, 2, 3, 4}
B = {3, 4, 5, 6}

# 1. Union
print("Union:", A | B)

# 2. Intersection
print("Intersection:", A & B)

# 3. Difference
print("Difference (A - B):", A - B)

# 4. Symmetric Difference
print("Symmetric Difference:", A ^ B)



▶️ Expected Output

Union: {1, 2, 3, 4, 5, 6}
Intersection: {3, 4}
Difference (A - B): {1, 2}
Symmetric Difference: {1, 2, 5, 6}
